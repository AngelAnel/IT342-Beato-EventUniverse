<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="22sp"
                android:textColor="@color/cream"
                android:background="@drawable/back_button_background"
                android:padding="0dp"/>

        </LinearLayout>

        <!-- Logo -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logonobg"
            android:contentDescription="Logo"
            android:layout_marginBottom="12dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register as Participant"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/dark_maroon"
            android:fontFamily="serif"
            android:layout_marginBottom="28dp"/>

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="28dp">

            <!-- PARTICIPANT FIELDS -->
            <LinearLayout
                android:id="@+id/layoutParticipant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView style="@style/FieldLabel" android:text="First Name"/>
                <EditText
                    android:id="@+id/etFirstName"
                    style="@style/FieldInput"
                    android:hint="Enter first name"
                    android:inputType="textPersonName"/>

                <TextView style="@style/FieldLabel" android:text="Last Name"/>
                <EditText
                    android:id="@+id/etLastName"
                    style="@style/FieldInput"
                    android:hint="Enter last name"
                    android:inputType="textPersonName"/>

                <TextView style="@style/FieldLabel" android:text="Institutional Email"/>
                <EditText
                    android:id="@+id/etEmailParticipant"
                    style="@style/FieldInput"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"/>

                <TextView style="@style/FieldLabel" android:text="Password"/>
                <EditText
                    android:id="@+id/etPasswordParticipant"
                    style="@style/FieldInput"
                    android:hint="Enter password"
                    android:inputType="textPassword"/>

                <TextView style="@style/FieldLabel" android:text="Confirm Password"/>
                <EditText
                    android:id="@+id/etConfirmPasswordParticipant"
                    style="@style/FieldInput"
                    android:hint="Confirm password"
                    android:inputType="textPassword"/>

                <TextView style="@style/FieldLabel" android:text="Department"/>
                <Spinner
                    android:id="@+id/spinnerParticipant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <!-- ORGANIZER FIELDS -->
            <LinearLayout
                android:id="@+id/layoutOrganizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="Organizational Name"/>
                <EditText
                    android:id="@+id/etOrgName"
                    style="@style/FieldInput"
                    android:hint="Enter organization name"
                    android:inputType="textPersonName"/>

                <TextView style="@style/FieldLabel" android:text="Institutional Email"/>
                <EditText
                    android:id="@+id/etEmailOrganizer"
                    style="@style/FieldInput"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"/>

                <TextView style="@style/FieldLabel" android:text="Password"/>
                <EditText
                    android:id="@+id/etPasswordOrganizer"
                    style="@style/FieldInput"
                    android:hint="Enter password"
                    android:inputType="textPassword"/>

                <TextView style="@style/FieldLabel" android:text="Confirm Password"/>
                <EditText
                    android:id="@+id/etConfirmPasswordOrganizer"
                    style="@style/FieldInput"
                    android:hint="Confirm password"
                    android:inputType="textPassword"/>

                <TextView style="@style/FieldLabel" android:text="Department"/>
                <Spinner
                    android:id="@+id/spinnerOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <!-- Error -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFCCCC"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <!-- Register button -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:text="register"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:background="@drawable/red_button_background"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

        <!-- Login link -->
        <TextView
            android:id="@+id/tvLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login here"
            android:textColor="#8B6B4A"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</ScrollView>