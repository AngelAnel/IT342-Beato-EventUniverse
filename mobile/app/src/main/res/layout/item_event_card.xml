<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:layout_marginBottom="16dp">

    <!-- EVENT PICTURE -->
    <ImageView
        android:id="@+id/ivEventPicture"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logonobg"/>

    <!-- EVENT INFO (dark maroon bottom section) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_maroon"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event Title"
                android:textColor="#f5f0e8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONGOING"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:background="@drawable/status_badge_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

        </LinearLayout>

        <!-- Organizer -->
        <TextView
            android:id="@+id/tvOrganizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="by [Organization]"
            android:textColor="#D9F5F0E8"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:layout_marginBottom="2dp"/>

        <!-- Price + Dept + Payment -->
        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P 300 • Open for All • Online/Onsite"
            android:textColor="#d4c9b8"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp"/>

        <!-- Location + Date + Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLocationDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[Location] [Date]"
                android:textColor="#b0a090"
                android:textSize="11sp"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/tvActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textColor="#f5f0e8"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:padding="4dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>