<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EventUniverse" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/dark_maroon</item>
        <item name="colorPrimaryVariant">@color/bright_red</item>
        <item name="colorOnPrimary">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F5F0E8</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
</resources>